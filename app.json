{
  "expo": {
    "name": "vvoice-hano",
    "slug": "vvoice-hano",
    "version": "1.2.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.arcadalabs.bizinvoices"
    },
    "android": {
      "package": "com.arcadalabs.bizinvoices",
      "versionCode": 4,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "extra": {
      "eas": {
        "projectId": "bf98160b-0ddc-479d-858f-668307cd5a4e"
      }
    },
    "updates": {
      "url": "https://expo.dev"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "yaniyemen",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "plugins": [
      "expo-font"
    ]
  }
}
